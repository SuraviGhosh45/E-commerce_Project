  "type": "module",
  "main": "index.js",
  "scripts": {
    "install": "cd backend && npm install && cd ../frontend && npm install",
    "dev:server": "cd backend && npm run dev",
    "dev:client": "cd frontend && npm run dev",
    "dev": "concurrently npm:dev:server npm:dev:client",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "concurrently": "^10.0.5"
  }
}
